<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.DiscordRichPresence</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.DiscordRichPresence</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      Do not append the git commit hash to AssemblyInformationalVersion: the release
      checksum must be reproducible and must not change when manifest/release-notes
      commits are added after the artifact is built.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!--
      The release ZIP ships only the DLL, so a portable PDB is not useful. Omitting the
      debug directory also removes the PDB checksum (and thus the SourceLink commit hash)
      from the assembly, keeping the release checksum independent of git history.
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Plugin version — must match manifest.json and the release tag exactly -->
    <Version>1.4.0.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Jellyfin.Controller and Jellyfin.Model are marked PrivateAssets="All"
      so they are NOT packaged into the zip — Jellyfin provides them at runtime.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.9.0" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.0" PrivateAssets="All" />
    <!--
      Jellyfin.Controller 10.9.0 pulls in System.Text.Json 8.0.3 transitively, which is
      affected by CVE-2024-30105 and CVE-2024-43485. Reference the patched 8.0.x build so
      the project compiles against a non-vulnerable version; Jellyfin still provides the
      runtime assembly, and this reference is not shipped in the release ZIP.
    -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" PrivateAssets="All" />
    <!--
      Microsoft.AspNetCore.Http.Extensions 2.2.0 (transitive) pins the vulnerable
      System.Text.Encodings.Web 4.5.0 (GHSA-ghhp-997w-qr28). Override it with the
      .NET 8 assembly; this reference is compile-time only.
    -->
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Embed the HTML configuration page for the Jellyfin admin dashboard -->
  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <!-- Plugin logo displayed in Jellyfin's plugin catalog and admin panel -->
    <EmbeddedResource Include="logo.png" />
  </ItemGroup>

</Project>
