<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.DiscordRichPresence</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.DiscordRichPresence</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Jellyfin.Controller and Jellyfin.Model are marked PrivateAssets="All"
      so they are NOT packaged into the zip — Jellyfin provides them at runtime.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.9.0" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Embed the HTML configuration page for the Jellyfin admin dashboard -->
  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
